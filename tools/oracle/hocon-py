#!/bin/sh
# pyhocon oracle — same input and output format as hocon-java, so the two can be
# diffed against each other. pyhocon is NOT the authority: it deviates from the
# reference on several inputs (see README.md). It is here because it is the
# implementation this project is meant to replace.
set -e
DIR=$(cd "$(dirname "$0")" && pwd)
VENV="$DIR/venv"

if [ ! -x "$VENV/bin/python" ]; then
    python3 -m venv "$VENV"
    "$VENV/bin/pip" install -q --disable-pip-version-check pyhocon >&2
fi

if [ "${1:-}" = "--version" ]; then
    "$VENV/bin/python" -c 'import pyhocon,importlib.metadata as m; print("pyhocon", m.version("pyhocon"))'
    exit 0
fi

exec "$VENV/bin/python" "$DIR/oracle.py" "$@"
