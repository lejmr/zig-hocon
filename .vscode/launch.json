{
    "version": "0.2.0",
    "configurations": [
        {
            // F5 from anywhere in the project — no scrolling to a codelens.
            // Builds the test binary to a stable path first, so the debugger
            // always attaches to a fresh build.
            "name": "Debug tests",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/test",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build test binary",
            "terminal": "integrated"
        },
        {
            // Same, but stops on the first test whose name contains the filter.
            // Prompts for the filter each time it is started.
            "name": "Debug tests (filtered)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/test-filtered",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build filtered test binary",
            "terminal": "integrated"
        }
    ]
}
