{
  "spec": "HOCON.md#unchanged-from-json",
  "rule": [
    "unchanged-from-json.3",
    "unchanged-from-json.4"
  ],
  "why": "number formats match JSON, which has no size limit, so an integer past 2^63 is still a number; typesafe/config makes it a string (lightbend/config#801, ekrich/sconfig#631)",
  "expect": {
    "a": 9223372036854775808,
    "b": -9223372036854775809,
    "c": 123456789012345678901234567890
  },
  "java": "diverges",
  "java_expect": {
    "a": "9223372036854775808",
    "b": "-9223372036854775809",
    "c": "123456789012345678901234567890"
  },
  "resolve": true
}
